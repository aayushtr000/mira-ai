{
  "expo": {
    "name": "Mira AI Companion",
    "slug": "mira-ai-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mira.aicompanion"
    },
    "android": {
      "package": "com.mira.aicompanion",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE"
      ]
    },
    "plugins": [
      ["expo-speech"]
    ]
  }
}
